<section id="kallor" class="source-section"><div class="chapter">{{ pilot.sourceHeading }}</div><h2>Källor och manualer</h2><p>{{ pilot.sourceIntro }}</p><details class="source-disclosure"><summary>Visa källor och manualer <span aria-hidden="true">▾</span></summary><div class="source-disclosure-inner"><p>{{ pilot.sourceHelp }}</p>{% for item in pilot.sources %}<div class="source-record">{% if item.rawHtml %}{{ item.rawHtml | safe }}{% else %}<strong>{{ item.title | safe }}</strong><p>{{ item.description | safe }}</p>{% endif %}{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">Öppna dokumentet ↗</a>{% endif %}</div>{% endfor %}</div>{% if pilot.sourceOutro %}{{ pilot.sourceOutro | safe }}{% endif %}</details></section>